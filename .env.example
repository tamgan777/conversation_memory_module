# Conversation Memory Module - Environment Configuration

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False

# Database settings
# For SQLite (default):
DATABASE_URL=sqlite:///./conversation_memory.db

# For PostgreSQL (example):
# DATABASE_URL=postgresql://user:password@localhost:5432/conversation_memory

# For MySQL (example):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/conversation_memory

# CORS settings
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
